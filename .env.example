# ================================
# E-Commerce Product API — Environment Variables
# ================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# ─── Server ───────────────────────────────────────────
# Port the Express server will listen on
PORT=8080

# ─── Database ─────────────────────────────────────────
# MongoDB connection string (local or Atlas)
# Local example:  mongodb://localhost:27017/product_db
# Atlas example:  mongodb+srv://<user>:<password>@cluster.mongodb.net/product_db
MONGODB_URI=mongodb://localhost:27017/product_db

# ─── Authentication ────────────────────────────────────
# A long, random secret string used to sign JWT tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# ─── ImageKit ─────────────────────────────────────────
# Obtain these from your ImageKit dashboard → Developer Options
IMAGEKIT_PRIVATE_KEY=private_yourPrivateKeyFromImageKit=
